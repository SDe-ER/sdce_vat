msgid "KSA VAT Return"
msgstr "إقرار ضريبة القيمة المضافة - السعودية"

msgid "KSA VAT Return Detail"
msgstr "تفاصيل إقرار ضريبة القيمة المضافة - السعودية"

msgid "Accrual"
msgstr "الاستحقاق"

msgid "Adjustment (SAR)"
msgstr "التعديلات (ريال)"

msgid "Amount (SAR)"
msgstr "المبلغ (ريال)"

msgid "VAT Amount (SAR)"
msgstr "مبلغ الضريبة (ريال)"

msgid "Choose a field or show the exceptions"
msgstr "اختر خانة أو اعرض الاستثناءات"

msgid "Corrections from Previous Periods (VAT)"
msgstr "تصحيحات من الفترات السابقة (ضريبة القيمة المضافة)"

msgid "VAT Credit from Previous Periods"
msgstr "ضريبة القيمة المضافة المرحلة من الفترات السابقة"

msgid "Exceptions Only"
msgstr "الاستثناءات فقط"

msgid "Field ID"
msgstr "رمز الخانة"

msgid "From Date must be on or before To Date"
msgstr "يجب أن يكون «من تاريخ» في يوم «إلى تاريخ» أو قبله"

msgid "Generate the report first."
msgstr "أنشئ التقرير أولًا."

msgid "Invalid filters"
msgstr "عوامل التصفية غير صالحة"

msgid "Invoice No."
msgstr "رقم الفاتورة"

msgid "Net VAT"
msgstr "صافي الضريبة"

msgid "No published rule set was used; set the rule-set code in Saudi VAT Settings."
msgstr "لم تُستخدم أي مجموعة قواعد منشورة؛ حدّد رمز مجموعة القواعد في إعدادات ضريبة القيمة المضافة السعودية."

msgid "Not approvable"
msgstr "غير قابل للاعتماد"

msgid "Not permitted for company {0}"
msgstr "غير مسموح لك بالشركة {0}"

msgid "Only a VAT Preparer can save a snapshot"
msgstr "حفظ النسخة متاح لمُعد إقرار ضريبة القيمة المضافة فقط"

msgid "Only the accrual basis is supported"
msgstr "أساس الاستحقاق هو الأساس الوحيد المدعوم"

msgid "Party VAT Number"
msgstr "الرقم الضريبي للطرف"

msgid "Period Type"
msgstr "نوع الفترة"

msgid "Quarter"
msgstr "الربع"

msgid "Ready for review"
msgstr "جاهز للمراجعة"

msgid "Reconciled with General Ledger"
msgstr "مطابق لدفتر الأستاذ العام"

msgid "Rule Set"
msgstr "مجموعة القواعد"

msgid "Save Snapshot"
msgstr "حفظ نسخة"

msgid "Save a copy of this return as a draft Saudi VAT Return? Saving is not approval and not filing."
msgstr "حفظ نسخة من هذا الإقرار كمسودة إقرار ضريبة القيمة المضافة؟ الحفظ ليس اعتمادًا وليس تقديمًا."

msgid "Set From Date and To Date for a custom period"
msgstr "حدّد «من تاريخ» و«إلى تاريخ» للفترة المخصصة"

msgid "Set a company"
msgstr "حدّد الشركة"

msgid "Set a month between 1 and 12"
msgstr "حدّد شهرًا من 1 إلى 12"

msgid "Set a quarter"
msgstr "حدّد الربع"

msgid "Set a valid year"
msgstr "حدّد سنة صحيحة"

msgid "Show Exceptions"
msgstr "عرض الاستثناءات"

msgid "Source Lines"
msgstr "سطور المصدر"

msgid "Sources Needing Review"
msgstr "مصادر تحتاج إلى مراجعة"

msgid "Sources with Warnings"
msgstr "مصادر عليها تنبيهات"

msgid "Tax Basis"
msgstr "الأساس الضريبي"

msgid "Tax Date"
msgstr "تاريخ الضريبة"

msgid "The VAT accounts do not reconcile with the general ledger."
msgstr "حسابات ضريبة القيمة المضافة غير مطابقة لدفتر الأستاذ العام."

msgid "Treatment"
msgstr "المعالجة الضريبية"

msgid "Unknown field {0}"
msgstr "خانة غير معروفة {0}"

msgid "Unknown period type {0}"
msgstr "نوع فترة غير معروف {0}"

msgid "VAT Account"
msgstr "حساب ضريبة القيمة المضافة"

msgid "VAT return {0} already covers part of this period"
msgstr "إقرار ضريبة القيمة المضافة {0} يغطي جزءًا من هذه الفترة بالفعل"

msgid "VAT return {0} is approved for this period; record a correction with a Saudi VAT Amendment instead"
msgstr "إقرار ضريبة القيمة المضافة {0} معتمد لهذه الفترة؛ سجّل التصحيح بتعديل إقرار ضريبة القيمة المضافة بدلًا من ذلك"

msgid "{0} source lines are not placed in any field (missing or unverified rules, unknown tax dates or unclassified documents). Open the details to review them."
msgstr "{0} من سطور المصدر لم تُدرج في أي خانة (قواعد ناقصة أو غير متحقق منها، أو تواريخ ضريبة غير معروفة، أو مستندات غير مصنفة). افتح التفاصيل لمراجعتها."

msgid "Unknown baseline rule file {0}"
msgstr "ملف القواعد الأساسية {0} غير معروف"

msgid "Only a VAT Rule Maintainer can import a baseline rule file"
msgstr "استيراد ملف القواعد الأساسية متاح لمسؤول قواعد ضريبة القيمة المضافة فقط"

msgid "Rule set {0} already exists; it was not changed"
msgstr "مجموعة القواعد {0} موجودة بالفعل ولم يتم تغييرها"

msgid "Import Baseline Rules"
msgstr "استيراد القواعد الأساسية"

msgid "Baseline File"
msgstr "ملف القواعد الأساسية"

msgid "The rule set is created as a draft and every rule stays Pending until a verifier checks it against the official source."
msgstr "تُنشأ مجموعة القواعد كمسودة، وتبقى كل قاعدة بحالة قيد التحقق حتى يتحقق منها مراجع من المصدر الرسمي."

msgid "Set Effective From before Effective To"
msgstr "حدّد «تاريخ البداية» قبل «تاريخ النهاية»"

msgid "Effective From is not confirmed; enter the date the rules took effect before verification"
msgstr "تاريخ البداية غير مؤكد؛ أدخل تاريخ نفاذ القواعد قبل التحقق"

msgid "Row {0}: rule {1} takes effect on {2}, after the rule set starts on {3}"
msgstr "الصف {0}: القاعدة {1} تسري من {2}، أي بعد بداية مجموعة القواعد في {3}"

msgid "Required before verification. Leave empty while the date the rules took effect is not confirmed."
msgstr "مطلوب قبل التحقق. اتركه فارغًا ما دام تاريخ نفاذ القواعد غير مؤكد."

msgid "Row {0}: {1} must be an amount above 0"
msgstr "الصف {0}: يجب أن تكون {1} مبلغًا أكبر من صفر"

msgid "Correction in a later return not available"
msgstr "التصحيح في إقرار لاحق غير متاح"

msgid "{0} This does not mean that a self-amendment is required or suitable; check IR Art. 63 with your tax adviser."
msgstr "{0} ولا يعني ذلك أن التعديل الذاتي للإقرار مطلوب أو مناسب؛ راجع المادة 63 من اللائحة التنفيذية مع مستشارك الضريبي."

msgid "No single published rule set covers {0}."
msgstr "لا توجد مجموعة قواعد منشورة واحدة تغطي تاريخ {0}."

msgid "Choose the later return first: the limit depends on its period."
msgstr "اختر الإقرار اللاحق أولًا، لأن الحد يعتمد على فترته."

msgid "The VAT effect {0} is above the correction limit {1}."
msgstr "الأثر الضريبي {0} يتجاوز حد التصحيح {1}."

msgid "The date that decides the correction limit is not verified in the rule set."
msgstr "التاريخ الذي يحدد حد التصحيح غير متحقق منه في مجموعة القواعد."

msgid "How corrections are measured against the limit is not verified in the rule set."
msgstr "طريقة قياس التصحيحات مقابل الحد غير متحقق منها في مجموعة القواعد."

msgid "The correction limit is not verified in the rule set."
msgstr "حد التصحيح غير متحقق منه في مجموعة القواعد."
